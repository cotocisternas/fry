{
  "domain": "fry.local",
  "listen": "127.0.0.1:2626",
  "data_directory": "./.fry-collector-local",
  "max_message_bytes": 1048576,
  "member_capacity_bytes": 1073741824,
  "recovery_retention_hours": 168,
  "max_connections": 32,
  "max_in_flight": 8,
  "members": [
    {
      "id": "10000000000000000000000000000001",
      "domain": "local-a"
    },
    {
      "id": "10000000000000000000000000000002",
      "domain": "local-b"
    }
  ],
  "routes": [
    {
      "address": "invoices@example.test",
      "organization": "20000000000000000000000000000001",
      "inboxes": [
        "30000000000000000000000000000001"
      ]
    },
    {
      "address": "billing@example.test",
      "organization": "20000000000000000000000000000001",
      "inboxes": [
        "30000000000000000000000000000001"
      ]
    }
  ],
  "imap": {
    "listen": "127.0.0.1:1243",
    "accounts": [
      {
        "username": "invoices",
        "password_environment": "FRY_LOCAL_IMAP_PASSWORD",
        "organization": "20000000000000000000000000000001",
        "inbox": "30000000000000000000000000000001"
      }
    ]
  },
  "collections": [
    {
      "id": "40000000000000000000000000000001",
      "organization": "20000000000000000000000000000001",
      "inbox": "30000000000000000000000000000001",
      "address": "127.0.0.1:1143",
      "username": "invoices",
      "password_environment": "FRY_LOCAL_IMAP_PASSWORD",
      "loopback_plaintext": true,
      "delete_source": false,
      "mappings": [
        {
          "source": "INBOX",
          "destination": "Collected"
        }
      ]
    }
  ]
}
