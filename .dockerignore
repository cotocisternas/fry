# Only fresh, verified native outputs enter the packaging context. Repository
# sources, local configuration, credentials, and other artifacts stay outside it.
**
!Dockerfile
!.dockerignore
!runtime/
!runtime/linux-amd64/
!runtime/linux-arm64/
!runtime/linux-*/bin/
!runtime/linux-*/bin/fry
!runtime/linux-*/bin/fry-member
!runtime/linux-*/bin/fry-migrate
!runtime/linux-*/bin/fry-admin
!runtime/linux-*/licenses/
!runtime/linux-*/licenses/**
!runtime/linux-*/data/
