+				}
+			case "copy":
+				if err := f.s.CreateFolder(ctx, f.org, source, "Archive"); err != nil {
+					t.Fatal(err)
+				}
+			case "delete":
+				if err := f.s.CreateFolder(ctx, f.org, source, "DeleteMe"); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := f.s.CopyMail(ctx, f.org, source, "INBOX", "DeleteMe", uids, false); err != nil {
+					t.Fatal(err)
+				}
+			}
+			targetFolder, _, err := f.s.Mailbox(ctx, f.org, target, "INBOX")
+			if err != nil {
+				t.Fatal(err)
+			}
+			holder, err := f.pool.Begin(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer holder.Rollback(context.Background())
+			if _, err = holder.Exec(ctx, `SELECT id FROM fry_folder WHERE id=$1 FOR UPDATE`, targetFolder.ID.String()); err != nil {
+				t.Fatal(err)
+			}
+			type result struct {
+				n   int
+				err error
+			}
+			published := make(chan result, 1)
+			go func() { n, err := f.s.PublishMailboxes(ctx, 16); published <- result{n, err} }()
+			batchWaitQuery(t, f, "FOR UPDATE OF f")
+			// Each NOWAIT probe uses its own transaction: a lock error aborts that probe.
+			// All receipt guards must already be held while the group waits for INBOX.
+			for _, r := range receipts {
+				probe, err := f.pool.Begin(ctx)
+				if err != nil {
+					t.Fatal(err)
+				}
+				_, probeErr := probe.Exec(ctx, `SELECT id FROM fry_receipt WHERE id=$1 FOR UPDATE NOWAIT`, r.ID.String())
+				probe.Rollback(context.Background())
+				var pgErr *pgconn.PgError
+				if !errors.As(probeErr, &pgErr) || pgErr.Code != "55P03" {
+					t.Fatal("folder acquired before every receipt guard", r.ID, probeErr)
+				}
+			}
+			mutated := make(chan error, 1)
+			go func() {
+				var err error
+				switch operation {
+				case "expunge":
+					_, err = f.s.Expunge(ctx, f.org, source, "INBOX", uids)
+				case "copy":
+					_, err = f.s.CopyMail(ctx, f.org, source, "INBOX", "Archive", uids, false)
+				case "delete":
+					err = f.s.DeleteFolder(ctx, f.org, source, "DeleteMe")
+				}
+				mutated <- err
+			}()
+			batchWaitQuery(t, f, "SELECT lifecycle FROM fry_receipt")
+			if err = holder.Rollback(ctx); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case result := <-published:
+				if result.n != 3 || result.err != nil {
+					t.Fatal(result)
+				}
+			case <-ctx.Done():
+				t.Fatal("publication deadlocked with mailbox mutation")
+			}
+			select {
+			case err := <-mutated:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-ctx.Done():
+				t.Fatal("mailbox mutation deadlocked with publication")
+			}
+			_, mail, err := f.s.Mailbox(ctx, f.org, target, "INBOX")
+			if err != nil || len(mail) != 3 {
+				t.Fatal(mail, err)
+			}
+			for i, m := range mail {
+				if m.UID != uint32(i+1) || m.Receipt != receipts[i].ID {
+					t.Fatal("lock order changed publication order", i, m)
+				}
+			}
+			memberships := int64(6)
+			if operation == "expunge" {
+				memberships = 3
+			}
+			if operation == "copy" {
+				memberships = 9
+			}
+			batchWantOwnership(t, f, memberships, 0)
+		})
+	}
+}
+func TestMailboxBatchExplicitFolderUsesIndividualPath(t *testing.T) {
+	f := setup(t)
+	ctx := context.Background()
+	inbox := newID(t)
+	if err := f.s.EnsureInbox(ctx, f.org, inbox); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.s.CreateFolder(ctx, f.org, inbox, "Explicit"); err != nil {
+		t.Fatal(err)
+	}
+	folder, _, err := f.s.Mailbox(ctx, f.org, inbox, "Explicit")
+	if err != nil {
+		t.Fatal(err)
+	}
+	env := Envelope{Organization: f.org, MailFrom: "sender@example.test", Destinations: []Destination{{Inbox: inbox, Folder: folder.ID, Recipients: []string{"recipient@example.test"}}}}
+	for i := 0; i < 2; i++ {
+		accept(t, f.s, newID(t), env, "explicit folder publication remains individual")
+	}
+	if n, err := f.s.PublishMailboxes(ctx, 16); n != 2 || err != nil {
+		t.Fatal(n, err)
+	}
+	if n := scalar(t, f.pool, `SELECT count(DISTINCT xmin::text) FROM fry_mail`); n != 2 {
+		t.Fatal("explicit folder used group commit", n)
+	}
+	_, mail, err := f.s.Mailbox(ctx, f.org, inbox, "Explicit")
+	if err != nil || len(mail) != 2 {
+		t.Fatal(mail, err)
+	}
+}
