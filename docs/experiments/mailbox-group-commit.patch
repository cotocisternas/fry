+type mailboxGroupResult struct {
+	published int
+	fallback  bool
+}
+
+// publishMailboxGroupTx owns tx. It holds every distinct receipt guard in ID
+// order before touching any folder, then allocates UIDs in original queue order.
+// Only an acknowledged precommit rollback permits individual fallback. Once
+// Commit is attempted, any error leaves zero known group count and no fallback.
+func publishMailboxGroupTx(ctx context.Context, tx pgx.Tx, group []mailboxWork) (mailboxGroupResult, error) {
+	defer rollback(tx)
+	fallback := func(cause error) (mailboxGroupResult, error) {
+		cleanup, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		err := tx.Rollback(cleanup)
+		cancel()
+		if err != nil {
+			return mailboxGroupResult{}, errors.Join(ErrUncertain, cause, err)
+		}
+		if err = ctx.Err(); err != nil {
+			return mailboxGroupResult{}, err
+		}
+		return mailboxGroupResult{fallback: true}, nil
+	}
+	if len(group) < 2 || len(group) > mailboxPublicationGroupLimit {
+		return fallback(ErrConflict)
+	}
+	unique := map[ID]bool{}
+	var receipts []ID
+	for _, w := range group {
+		if w.o != group[0].o || w.i != group[0].i {
+			return fallback(ErrConflict)
+		}
+		if !unique[w.r] {
+			unique[w.r] = true
+			receipts = append(receipts, w.r)
+		}
+	}
+	sort.Slice(receipts, func(i, j int) bool { return receipts[i].String() < receipts[j].String() })
+	for _, receipt := range receipts {
+		if _, err := lockReceipt(ctx, tx, group[0].o, receipt); err != nil {
+			return fallback(err)
+		}
+	}
+	// Work metadata is authoritative only under its receipt guard. A disappeared
+	// item remains an idempotent no-op; explicit-folder work uses the old path.
+	// Flags/internal dates are preserved by the unchanged publication helper.
+	for _, w := range group {
+		var folder *string
+		err := tx.QueryRow(ctx, `SELECT folder FROM fry_work WHERE receipt=$1 AND inbox=$2`, w.r.String(), w.i.String()).Scan(&folder)
+		if errors.Is(err, pgx.ErrNoRows) {
+			continue
+		}
+		if err != nil {
+			return fallback(err)
+		}
+		if folder != nil {
+			return fallback(ErrConflict)
+		}
+	}
+	published := 0
+	for _, w := range group {
+		added, err := publishMailboxInTransaction(ctx, tx, w.o, w.r, w.i, false)
+		if err != nil {
+			return fallback(err)
+		}
+		if added {
+			published++
+		}
+	}
+	if err := commit(ctx, tx); err != nil {
+		return mailboxGroupResult{}, err
+	}
+	return mailboxGroupResult{published: published}, nil
 }
 
